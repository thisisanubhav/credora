# Copy to .env for local development. Never commit real values.

# Application
APP_ENV=local
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# PostgreSQL (local-only placeholder values)
POSTGRES_DB=loan_engine
POSTGRES_USER=loan_engine
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://loan_engine:change-me-local-only@postgres:5432/loan_engine

# Object storage. Local development may use LocalStack/MinIO only if adopted in M1.
AWS_REGION=ap-south-1
UPLOAD_BUCKET=loan-engine-local-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-a-random-local-value
N8N_WEBHOOK_URL=http://n8n:5678
N8N_MATCHING_WEBHOOK_PATH=/webhook/loan-matching
N8N_WEBHOOK_HMAC_SECRET=replace-with-a-random-local-value

# Gemini (optional until product extraction is implemented)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-model-to-be-pinned-during-implementation

# SES. Keep sandbox/test settings for development.
SES_FROM_ADDRESS=
SES_TEST_INBOX_BASE=
EMAIL_DELIVERY_MODE=redirect_to_test_inbox


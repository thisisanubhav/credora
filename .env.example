# Run `make init` to create an ignored .env with random local secrets.
# These values describe LOCAL infrastructure only; no cloud credentials are needed.

# Compose project identity. Change only if another checkout uses the same name.
COMPOSE_PROJECT_NAME=loan-eligibility-engine

# PostgreSQL 16: the official entrypoint creates POSTGRES_DB and POSTGRES_USER.
# POSTGRES_USER is a local bootstrap administrator; M2 will introduce app runtime roles.
POSTGRES_DB=loan_engine
POSTGRES_USER=loan_engine_admin
POSTGRES_PASSWORD=GENERATE_LOCAL_SECRET
POSTGRES_PORT=5432

# M2 application DML role (no DDL). The bootstrap POSTGRES_USER performs migrations.
# The dedicated test database is never the application or n8n database.
APP_DB_USER=loan_engine_runtime
APP_DB_PASSWORD=GENERATE_LOCAL_SECRET
TEST_DB_NAME=loan_engine_test

# Separate database and login used only by n8n internal persistence.
# The init script creates both when the PostgreSQL volume is first initialized.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_local
N8N_DB_PASSWORD=GENERATE_LOCAL_SECRET

# n8n editor and webhook base URL are reachable only on this machine.
# Keep N8N_ENCRYPTION_KEY stable while retaining the n8n volume and database.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=GENERATE_LOCAL_SECRET
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# LocalStack S3 emulator. test/test are public emulator-only dummy values, not cloud credentials.
LOCALSTACK_PORT=4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:4566
S3_BUCKET=loan-engine-local
CSV_MAX_BYTES=10000000
CSV_CHUNK_SIZE=500
UPLOAD_URL_TTL_SECONDS=600
INGESTION_LEASE_SECONDS=900

# M4: Gemini is optional. Leave the key blank for deterministic-only discovery.
# The stable model ID is verified in Google AI's current model documentation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# M5: local HMAC between dispatcher and internal verifier. Never put the value in workflow JSON.
MATCHING_WEBHOOK_SECRET=GENERATE_LOCAL_SECRET
MATCHING_WEBHOOK_URL=http://127.0.0.1:5678/webhook/loan-matching
# Local-only opt-in. A demo batch can see synthetic products; ordinary batches cannot.
ALLOW_SYNTHETIC_DEMO=1


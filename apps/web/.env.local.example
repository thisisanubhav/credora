# Browser-visible address of the existing loopback FastAPI upload API.
NEXT_PUBLIC_UPLOAD_API_URL=http://127.0.0.1:8000
# Must match CSV_MAX_BYTES in the ignored root .env (default 10 MB).
NEXT_PUBLIC_CSV_MAX_BYTES=10000000
# Optional local-only UI toggle; API also requires ALLOW_SYNTHETIC_DEMO=1 and refuses demo mode in AWS.
# NEXT_PUBLIC_ENABLE_DEMO_UPLOAD=1

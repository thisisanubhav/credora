# Future AWS deployment prerequisites ONLY. Never source this during the zero-budget milestone.
# These are illustrative non-secret shapes, not provisioned resources or credentials.
AWS_REGION=us-east-1
FRONTEND_ORIGIN=https://upload.example.org
JWT_ISSUER_URL=https://issuer.example.org
JWT_AUDIENCE=loan-engine-client
UPLOAD_BUCKET_NAME=loan-engine-dev-ACCOUNTID-uploads
PRIVATE_SUBNET_A_ID=subnet-REPLACE_A
PRIVATE_SUBNET_B_ID=subnet-REPLACE_B
LAMBDA_SECURITY_GROUP_ID=sg-REPLACE
DB_HOST=private-rds.example.internal
DB_NAME=loan_engine
DB_RUNTIME_USER=loan_engine_runtime
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNTID:secret:loan-engine-runtime

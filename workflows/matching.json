        110,
        90
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst canonical = value => Array.isArray(value) ? `[${value.map(canonical).join(',')}]` : (value !== null && typeof value === 'object' ? `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonical(value[key])}`).join(',')}}` : JSON.stringify(value));\nreturn $input.all().map((item, index) => {\n  const input = item.json;\n  const payload = JSON.parse(JSON.stringify({body:input.body,headers:input.headers}));\n  const key_id = $env.INTERNAL_STEP_KEY_ID;\n  const secret = $env.INTERNAL_STEP_SECRET;\n  if (!key_id || !secret || secret.length < 32) throw new Error('internal_signer_unconfigured');\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const nonce = crypto.randomUUID();\n  const message = [key_id, timestamp, nonce, 'POST', '/matching/accept', canonical(payload)].join('\\n');\n  const signature = crypto.createHmac('sha256', secret).update(message).digest('hex');\n  return {json: {payload, internal_auth: {key_id, timestamp, nonce, signature}}, pairedItem: {item: index}};\n});"
      }
